# ---- 管理员初始凭据 ----
# 密码为必填项（compose 未设置会拒绝启动），请改成一个强密码。
# 注意：它只在 admin 账号首次创建时生效，之后以库内密码为准。
FARM_ADMIN_USERNAME=admin
FARM_ADMIN_PASSWORD=

# 默认只运行农场服务，适合低配置机器。
NAPCAT_LOGIN_ENABLED=false

# 开启 NapCat：取消下列注释。首次启动会自动生成内部 Token。
# COMPOSE_PROFILES=napcat
# NAPCAT_LOGIN_ENABLED=true
# 设备名（QQ 登录记录里显示的名字），默认为 qq-farm-bot；建议只使用字母、数字和连字符，
# 首次登录后保持不变，修改后需要重建 NapCat 容器才生效。
# NAPCAT_DEVICE_NAME=qq-farm-bot

# NapCat WebUI 监听地址与端口（默认只监听本机，不要改成 0.0.0.0）
# NAPCAT_WEBUI_HOST=127.0.0.1
# NAPCAT_WEBUI_PORT=6099

# NapCat 镜像坐标。
#
# 重要：2026-11-16 起作者已把 mlikiowa/napcat-docker 等镜像从 Docker Hub 下架，
# 直连 https://hub.docker.com/u/mlikiowa 已看不到这些仓库，拉取会报
# "repository does not exist"。所以默认值带一个仍可用的加速前缀。
#
# 下面按「能用」的顺序给几组可选值，换掉 NAPCAT_IMAGE 后执行 ./start.sh restart 即可：
#   NAPCAT_IMAGE=docker.m.daocloud.io/mlikiowa/napcat-docker:v4.18.42   # 默认，DaoCloud 仍有缓存
#   NAPCAT_IMAGE=docker.m.daocloud.io/mlikiowa/napcat-docker:v4.18.41
#   NAPCAT_IMAGE=docker.m.daocloud.io/mlikiowa/napcat-docker:latest
#   NAPCAT_IMAGE=docker.1ms.run/mlikiowa/napcat-docker:v4.18.42        # 该源没有缓存时会失败
#
# 官方镜像均为 Linux 容器，同时提供 amd64 和 arm64；不提供 32 位 x86 (linux/386)。
# 本机已导入离线镜像（docker load -i napcat-docker-v4.18.42-amd64.tar）时，
# 把 NAPCAT_IMAGE 写成该 tar 里的 tag 即可，脚本会优先使用本地镜像、不再拉取。
NAPCAT_IMAGE=docker.m.daocloud.io/mlikiowa/napcat-docker:v4.18.42
